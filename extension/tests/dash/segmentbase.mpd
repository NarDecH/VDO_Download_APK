<?xml version="1.0" encoding="utf-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static" mediaPresentationDuration="PT4S" profiles="urn:mpeg:dash:profile:isoff-on-demand:2011">
  <Period>
    <AdaptationSet contentType="video" mimeType="video/mp4">
      <!-- On-demand profile: SegmentBase/indexRange - the media is ONE
           self-contained fMP4 file per Representation and the index is a
           byte range inside it. The extension downloads the file whole via
           the <BaseURL> ELEMENT TEXT of the chosen Representation (v1:
           highest bandwidth). v2 points at a missing file on purpose - if
           the parser picked the wrong Representation the download 404s. -->
      <Representation id="v1" bandwidth="1200000" mimeType="video/mp4" codecs="avc1.64001f" width="1280" height="720">
        <BaseURL>single.mp4</BaseURL>
        <SegmentBase indexRange="0-863">
          <Initialization range="0-863" />
        </SegmentBase>
      </Representation>
      <Representation id="v2" bandwidth="800000" mimeType="video/mp4" codecs="avc1.64001e" width="640" height="360">
        <BaseURL>missing-v2.mp4</BaseURL>
        <SegmentBase indexRange="0-863">
          <Initialization range="0-863" />
        </SegmentBase>
      </Representation>
    </AdaptationSet>
  </Period>
</MPD>
