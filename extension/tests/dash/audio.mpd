<?xml version="1.0" encoding="utf-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static" mediaPresentationDuration="PT8S" profiles="urn:mpeg:dash:profile:isoff-live:2011">
  <Period>
    <!-- Standard streaming layout: video and audio in SEPARATE AdaptationSets.
         The browser cannot remux, so the assembled file would be video-only
         (smaller than the desktop app's ffmpeg merge and silent) - the SW
         must refuse this MPD with a clear message instead. -->
    <AdaptationSet contentType="video" mimeType="video/mp4">
      <SegmentTemplate timescale="1000" duration="4000" startNumber="1"
                       initialization="init.mp4" media="seg$Number$.m4s" />
      <Representation id="v2" bandwidth="1200000" width="1280" height="720" codecs="avc1.64001f" />
    </AdaptationSet>
    <AdaptationSet contentType="audio" mimeType="audio/mp4" lang="en">
      <Representation id="a1" bandwidth="128000" audioSamplingRate="48000" codecs="mp4a.40.2" />
    </AdaptationSet>
  </Period>
</MPD>
