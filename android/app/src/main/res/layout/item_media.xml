<?xml version="1.0" encoding="utf-8"?>
<!-- v1.9.19: rows gained a 16:9 video thumbnail (mThumb; mPosterLabel is
     the 🎬 placeholder shown while the image loads) and a size line (mSize). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <FrameLayout
        android:id="@+id/mThumbWrap"
        android:layout_width="96dp"
        android:layout_height="60dp"
        android:layout_marginEnd="10dp"
        android:background="#0B1120">

        <ImageView
            android:id="@+id/mThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/download"
            android:visibility="gone" />

        <TextView
            android:id="@+id/mPosterLabel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="🎬"
            android:textSize="20sp"
            android:textColor="#33477A" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

    <TextView
        android:id="@+id/mLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFC371"
        android:textStyle="bold"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/mSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#7D8DB1"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/mUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#93A4C3"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/mDl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_bg"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/download"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mCopy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="#243354"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/copy_link"
            android:textColor="#CDD6E6" />

        <TextView
            android:id="@+id/mOpen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="#78350f"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/open_embed"
            android:textColor="#FCD34D"
            android:visibility="gone" />

        <TextView
            android:id="@+id/mDel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="#7f1d1d"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/delete"
            android:textColor="#FCA5A5"
            android:visibility="gone" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
