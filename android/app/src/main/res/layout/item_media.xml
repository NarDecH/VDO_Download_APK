<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/mLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFC371"
        android:textStyle="bold"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/mUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#93A4C3"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/mDl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_bg"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/download"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mCopy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="#243354"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/copy_link"
            android:textColor="#CDD6E6" />

        <TextView
            android:id="@+id/mOpen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="#78350f"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/open_embed"
            android:textColor="#FCD34D"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
