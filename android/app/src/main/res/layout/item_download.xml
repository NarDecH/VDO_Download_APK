<?xml version="1.0" encoding="utf-8"?>
<!-- v1.5.0: one row in the media sheet's "กำลังดาวน์โหลด" tab - an active
     stream job with its live percent, a determinate bar and a per-row
     ยกเลิก button (ids: dLabel / dPct / dBar / dCancel). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/dLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFC371"
            android:textStyle="bold"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/dPct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="#E8ECF4"
            android:textStyle="bold"
            android:textSize="14sp"
            android:minWidth="46sp"
            android:gravity="end" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/dBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progressTint="#FF5F6D" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <!-- v1.7.0: หยุดพัก keeps yt-dlp's .part files - ดาวน์โหลดต่อ later -->
        <TextView
            android:id="@+id/dPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="#4a3208"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/pause"
            android:textColor="#FFC371" />

        <TextView
            android:id="@+id/dCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#7f1d1d"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/cancel"
            android:textColor="#FCA5A5" />
    </LinearLayout>
</LinearLayout>
